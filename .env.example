# ArthX Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Application Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///../data/arthx.db

# CORS Configuration (comma-separated allowed origins for frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM API Key (leave blank for template/offline fallback mode; paste Gemini key before Phase 2)
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
EXPLAINABILITY_MODE=auto
